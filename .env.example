# Copiar a .env solo si quieres sobreescribir los defaults de docker-compose.
# docker compose lee este archivo automáticamente si se llama .env

POSTGRES_USER=toka
POSTGRES_PASSWORD=toka_secret
RABBITMQ_DEFAULT_USER=toka
RABBITMQ_DEFAULT_PASS=toka_secret

JWT_SECRET=toka-dev-jwt-secret-change-me-32b
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
INTERNAL_TOKEN=toka-internal-dev-token

SEED_ADMIN_EMAIL=admin@toka.local
SEED_ADMIN_PASSWORD=Toka2026!
SEED_ADMIN_NAME=Administrador Toka

# API oficial de OpenAI. Sin esta clave el asistente responde degradado.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-nano
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_INPUT_USD_PER_MILLION=0.05
OPENAI_OUTPUT_USD_PER_MILLION=0.40
OPENAI_EMBED_USD_PER_MILLION=0.02

TYPEORM_SYNC=true
